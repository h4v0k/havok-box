{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(hb hw)",
      "Bash(hb profiles)",
      "Bash(hb last)",
      "Bash(hb hosts *)",
      "Bash(hb ports *)",
      "Bash(hb diff *)",
      "Bash(havokbox-net status)",
      "Bash(python3 -m pytest *)",
      "Bash(hb engage)",
      "Bash(hb engage status)",
      "Bash(hb find)",
      "Bash(hb kit list)",
      "Bash(hb kit show *)"
    ],
    "ask": [
      "Bash(hb scan *)",
      "Bash(hb flow *)",
      "Bash(sudo *)",
      "Bash(nmap *)",
      "Bash(systemctl *)",
      "Bash(nmcli *)",
      "Bash(hb find *)",
      "Bash(arp-scan *)",
      "Bash(hb kit run *)",
      "Bash(hb kit --gui*)",
      "Bash(hb kit)"
    ],
    "deny": [
      "Bash(rfcat *)",
      "Bash(aireplay-ng *)",
      "Bash(mdk4 *)",
      "Bash(mitm6 *)",
      "Bash(responder *)",
      "Bash(hydra *)",
      "Edit(/config/scope.yaml)",
      "Edit(/config/box.json)",
      "Read(//etc/havokbox/**)",
      "Read(//data/havokbox/secrets/**)",
      "Bash(hb engage start*)",
      "Bash(hb engage end*)",
      "Edit(//data/havokbox/engagement.json)",
      "Write(//data/havokbox/engagement.json)",
      "Bash(*engagement.json*)",
      "Write(/config/scope.yaml)",
      "Edit(//data/havokbox/owned.json)",
      "Write(//data/havokbox/owned.json)",
      "Bash(*owned.json*)",
      "Bash(*/api/mine*)",
      "Bash(*/api/engagement/*)"
    ]
  }
}
