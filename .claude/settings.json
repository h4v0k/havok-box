{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(hb hw)",
      "Bash(hb profiles)",
      "Bash(hb last)",
      "Bash(hb hosts *)",
      "Bash(hb ports *)",
      "Bash(hb diff *)",
      "Bash(havokbox-net status)",
      "Bash(python3 -m pytest *)"
    ],
    "ask": [
      "Bash(hb scan *)",
      "Bash(hb flow *)",
      "Bash(sudo *)",
      "Bash(nmap *)",
      "Bash(systemctl *)",
      "Bash(nmcli *)"
    ],
    "deny": [
      "Bash(rfcat *)",
      "Bash(aireplay-ng *)",
      "Bash(mdk4 *)",
      "Bash(mitm6 *)",
      "Bash(responder *)",
      "Bash(hydra *)",
      "Edit(/config/scope.yaml)",
      "Edit(/config/box.json)",
      "Read(//etc/havokbox/**)",
      "Read(//data/havokbox/secrets/**)"
    ]
  }
}
